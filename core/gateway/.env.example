# NoblePort MCP Gateway configuration
DATABASE_URL=postgresql://noble:noble@postgres:5432/noble
REDIS_URL=redis://redis:6379/0

# "production" turns on the strict boot checks (https-only CORS, ADMIN_TOKEN
# required). Every other security check below applies in EVERY environment.
ENVIRONMENT=development

# --- Authentication (REQUIRED — the gateway refuses to boot without a key) ---
# Exactly one of:
#   JWT_SECRET      HS256 shared secret, >= 32 chars. Generate one:
#                     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   JWT_PUBLIC_KEY  PEM public key or JSON JWK for RS256 / ES256 / EdDSA
#                   (OIDC_JWK is accepted as an alias)
JWT_SECRET=
# JWT_PUBLIC_KEY=
# JWT_ALGORITHMS=HS256          # optional allowlist; "none" is never accepted
JWT_AUDIENCE=nobleport-mcp-gateway   # every token must carry this `aud`
JWT_ISSUER=https://auth.nobleport.ai # every token must carry this `iss`
JWT_LEEWAY_S=30
JWT_MAX_TTL_S=86400

# --- CORS: explicit comma-separated origin allowlist. "*" is rejected. ------
# Empty = no cross-origin access (development) / refuse to boot (production).
FRONTEND_ORIGIN=https://ops.nobleport.ai

# --- Uploads (POST /agent/upload, requires scope gateway:upload) ------------
UPLOAD_DIR=/var/lib/nobleport/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,image/webp,application/pdf,text/plain

# Governance
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_PER_MIN=20
CACHE_TTL_S=60

# KPI snapshot worker
KPI_INTERVAL_S=600
ENABLE_KPI_WORKER=true

# Tool execution: false = STAGED stub executor; true = call real agent endpoints
USE_HTTP_EXECUTOR=false
TOOL_TIMEOUT_S=10

# Second factor for the kill switch (in addition to a bearer token carrying
# gateway:admin). Required in production; placeholder values are rejected.
ADMIN_TOKEN=

LOG_LEVEL=INFO
