# Netlify Environment Variables — nobleport.ai
# Set these in Netlify Dashboard → Site Settings → Build & Deploy → Environment Variables
# Scope all to: Production context

# ─── HARD GATE (required for Telegram to function) ───────────────────────────
TELEGRAM_BOT_TOKEN=         # From BotFather — @StephanieNoblePortBot token
                            # Never commit this value. Netlify env is the only correct sink.

# ─── OPTIONAL — MCP Gateway (enables live data routing) ──────────────────────
MCP_GATEWAY_URL=            # NoblePort MCP Gateway base URL (e.g. https://gateway.nobleport.ai)
                            # Without this, function runs in STAGED stub mode (advisory only)
MCP_ADMIN_TOKEN=            # X-Admin-Token for gateway authentication

# ─── OPTIONAL — Security ─────────────────────────────────────────────────────
TELEGRAM_SECRET_TOKEN=      # Webhook secret (set in BotFather setWebhook call for signature verification)
NETLIFY_ADMIN_REGISTER_TOKEN=  # Protects the /register-webhook utility endpoint

# ─── VERIFICATION CHECKLIST ──────────────────────────────────────────────────
# After setting TELEGRAM_BOT_TOKEN and deploying:
#
# Step 1: Trigger redeploy in Netlify (env var picked up automatically)
# Step 2: Register webhook — call:
#         GET https://nobleport.ai/.netlify/functions/register-webhook?admin=YOUR_NETLIFY_ADMIN_REGISTER_TOKEN
# Step 3: Verify webhook — call:
#         https://api.telegram.org/bot<TOKEN>/getWebhookInfo
#         → Look for: "url": "https://nobleport.ai/.netlify/functions/telegram-webhook", "pending_update_count": 0
# Step 4: Open Telegram, message your bot /start
# Step 5: Confirm Stephanie responds with welcome message
#
# Only mark Stephanie as LIVE after Step 5 is observed end-to-end.
