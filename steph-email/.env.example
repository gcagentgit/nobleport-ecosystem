# Copy to /etc/steph-email.env on the VPS; restrict file permissions to 0600.
# Never paste credentials into chat. This file contains names only.
STEPH_DASHBOARD_TOKEN=
STEPH_SESSION_SECRET=
STEPH_COOKIE_SECURE=true
STEPH_TOKEN_ENCRYPTION_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
OUTLOOK_CLIENT_ID=
OUTLOOK_REFRESH_TOKEN=
YAHOO_APP_PASSWORD=
NOTIFY_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
TELNYX_PUBLIC_KEY=
TELNYX_WEBHOOK_URL=
# Optional approved Stephanie voice through Telnyx's ElevenLabs integration.
TELNYX_VOICE=
TELNYX_ELEVENLABS_API_KEY_REF=
