# Stephanie.ai Voice backend — copy to .env and fill in what you have.
# Anything left blank runs in STAGED (simulated) mode.

# ElevenLabs (optional) — when set, neural synthesis goes through ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Twilio (optional) — when all three are set, calls and SMS use Twilio REST.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public URL Twilio can reach for webhooks / TwiML (ngrok, Netlify, etc.)
STEPHANIE_PUBLIC_BASE_URL=http://localhost:8000

# Human gate: outbound calls/SMS to real numbers require this value in the
# X-Human-Approval header. Leave blank to keep telephony simulated.
STEPHANIE_HUMAN_APPROVAL_TOKEN=
STEPHANIE_ADMIN_TOKEN=

STEPHANIE_HOST=0.0.0.0
STEPHANIE_PORT=8000
STEPHANIE_DEBUG=false
STEPHANIE_SAMPLE_RATE=44100
STEPHANIE_MAX_TEXT_LENGTH=5000
STEPHANIE_MAX_AUDIO_DURATION=600
