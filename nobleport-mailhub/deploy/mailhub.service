[Unit]
Description=NoblePort MailHub — unified inbox API and web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailhub
Group=mailhub
EnvironmentFile=-/etc/nobleport-mailhub/env
Environment=MAILHUB_DATA_DIR=/var/lib/nobleport-mailhub
WorkingDirectory=/var/lib/nobleport-mailhub
ExecStart=/opt/nobleport-mailhub/venv/bin/mailhub serve
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nobleport-mailhub
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
