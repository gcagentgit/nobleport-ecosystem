# Copy to .env (or export as environment variables). All keys are prefixed MAILHUB_.

# Where the SQLite database, secret key and rules.json live (default: ~/.local/share/nobleport-mailhub)
MAILHUB_DATA_DIR=/var/lib/nobleport-mailhub

# Fernet key for encrypting mailbox passwords / refresh tokens at rest.
# Leave unset to auto-generate <data_dir>/secret.key (mode 0600) on first run.
# Generate one: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#MAILHUB_SECRET_KEY=

# API bind. Keep 127.0.0.1 unless you also set MAILHUB_API_TOKEN and put TLS in front.
MAILHUB_HOST=127.0.0.1
MAILHUB_PORT=8025
#MAILHUB_API_TOKEN=change-me

# Sync cadence and limits
MAILHUB_SYNC_INTERVAL_S=120
MAILHUB_SYNC_BATCH=200
MAILHUB_INITIAL_BACKFILL=500
MAILHUB_FOLDERS=INBOX
MAILHUB_STORE_BODIES=true
MAILHUB_LOG_LEVEL=INFO
