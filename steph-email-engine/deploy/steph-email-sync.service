[Unit]
Description=Steph Email Engine — one-shot mailbox sync (fallback if the main service is down)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=steph
Group=steph
EnvironmentFile=-/etc/steph-email-engine/env
Environment=STEPH_EMAIL_DATA_DIR=/var/lib/steph-email-engine
WorkingDirectory=/var/lib/steph-email-engine
ExecStart=/opt/steph-email-engine/venv/bin/steph-email sync
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/steph-email-engine
