# Copy to .env (or export as environment variables). Every key is prefixed STEPH_EMAIL_.

# ---- storage
STEPH_EMAIL_DATA_DIR=/var/lib/steph-email-engine
# Fernet key for mailbox passwords / refresh tokens at rest. Leave unset to auto-generate <data_dir>/secret.key.
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#STEPH_EMAIL_SECRET_KEY=
STEPH_EMAIL_STORE_RAW=true            # keep every original .eml under <data_dir>/raw (cleanup depends on this)

# ---- dashboard / API (keep 127.0.0.1 unless you set an API token and put TLS in front)
STEPH_EMAIL_HOST=127.0.0.1
STEPH_EMAIL_PORT=8030
#STEPH_EMAIL_API_TOKEN=change-me
STEPH_EMAIL_PUBLIC_BASE_URL=https://steph.example.com   # what Twilio fetches TwiML + brief audio from

# ---- sync
STEPH_EMAIL_SYNC_INTERVAL_S=120
STEPH_EMAIL_FOLDERS=INBOX
STEPH_EMAIL_INITIAL_BACKFILL=500
STEPH_EMAIL_SYNC_BATCH=200

# ---- the owner
STEPH_EMAIL_OWNER_NAME=Michael
STEPH_EMAIL_OWNER_PHONE=+19785550100          # the ONLY number the engine will text or call
STEPH_EMAIL_OWNER_ADDRESSES=mike@nobleport.net # extra addresses that count as "me"
STEPH_EMAIL_TIMEZONE=America/New_York

# ---- urgency + expected replies
STEPH_EMAIL_VIP_SENDERS=                      # comma separated addresses that always score higher
STEPH_EMAIL_VIP_DOMAINS=ipswichma.gov,cooley.com
STEPH_EMAIL_REPLY_DUE_DAYS=3
STEPH_EMAIL_ALERTS_ENABLED=true
STEPH_EMAIL_ALERT_MIN_URGENCY=critical        # SMS immediately at or above this level

# ---- morning brief
STEPH_EMAIL_BRIEF_HOUR=7
STEPH_EMAIL_BRIEF_MINUTE=0
STEPH_EMAIL_BRIEF_LOOKBACK_HOURS=24
STEPH_EMAIL_BRIEF_SMS=true
STEPH_EMAIL_BRIEF_CALL=false                  # true = place a call that reads the brief

# ---- notifications: Twilio (leave blank = STAGED, nothing leaves the box)
#STEPH_EMAIL_TWILIO_ACCOUNT_SID=
#STEPH_EMAIL_TWILIO_AUTH_TOKEN=
#STEPH_EMAIL_TWILIO_FROM_NUMBER=+1...

# ---- voice option: ElevenLabs (leave blank = calls use Twilio's built-in voice)
#STEPH_EMAIL_ELEVENLABS_API_KEY=
#STEPH_EMAIL_ELEVENLABS_VOICE_ID=
STEPH_EMAIL_ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- cleanup (never deletes)
STEPH_EMAIL_CLEANUP_AFTER_DAYS=30
STEPH_EMAIL_CLEANUP_ARCHIVE_FOLDER=Steph/Archive
STEPH_EMAIL_CLEANUP_COPY_TO_SERVER=false      # also COPY archived mail into the archive folder on the server
STEPH_EMAIL_CLEANUP_AUTO=false                # run the cleanup pass before each morning brief
STEPH_EMAIL_LOG_LEVEL=INFO
